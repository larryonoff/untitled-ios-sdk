{% if tables.count > 0 %}
{% set accessModifier %}{% if param.publicAccess %}public{% else %}internal{% endif %}{% endset %}
{% if param.publicAccess %}public import Foundation{% else %}import Foundation{% endif %}

// MARK: - Localized Strings

{% macro parametersBlock types %}
  {%- for type in types -%}
    _ value{{forloop.counter}}: {{type}}
    {{ ", " if not forloop.last }}
  {%- endfor -%}
{% endmacro %}
{% macro interpolationBlock type index %}
  {%- if type == "String" -%}
  \(value{{index}})
  {%- elif type == "Int" -%}
  \(value{{index}}, specifier: "%lld")
  {%- elif type == "UInt" -%}
  \(value{{index}}, specifier: "%llu")
  {%- elif type == "Double" -%}
  \(value{{index}}, specifier: "%f")
  {%- elif type == "Float" -%}
  \(value{{index}}, specifier: "%f")
  {%- elif type == "UnsafeRawPointer" -%}
  \(Int(bitPattern: value{{index}}), specifier: "%lld")
  {%- else -%}
  #error("strings-swift6.stencil does not support the '{{type}}' interpolation type")
  {%- endif -%}
{% endmacro %}
{% macro interpolationsBlock types literals %}
  {%- if types.count == 1 -%}
  {{ literals.0 }}{% call interpolationBlock types.0 1 %}{{ literals.1 }}
  {%- elif types.count == 2 -%}
  {{ literals.0 }}{% call interpolationBlock types.0 1 %}{{ literals.1 }}{% call interpolationBlock types.1 2 %}{{ literals.2 }}
  {%- elif types.count == 3 -%}
  {{ literals.0 }}{% call interpolationBlock types.0 1 %}{{ literals.1 }}{% call interpolationBlock types.1 2 %}{{ literals.2 }}{% call interpolationBlock types.2 3 %}{{ literals.3 }}
  {%- else -%}
  #error("strings-swift6.stencil supports at most 3 placeholders per string; '{{ types.count }}' found")
  {%- endif -%}
{% endmacro %}
{% macro recursiveBlock table item %}
{% for string in item.strings %}
{% if not param.noComments %}
{% for line in string.comment|default:string.translation|split:"\n" %}
/// {{line}}
{% endfor %}
{% endif %}
{% set translation string.translation|replace:'"','\"'|replace:'	','\t' %}
{% set literals translation|replace:"%lld","\u0001"|replace:"%llu","\u0001"|replace:"%d","\u0001"|replace:"%u","\u0001"|replace:"%@","\u0001"|replace:"%f","\u0001"|replace:"%p","\u0001"|split:"\u0001" %}
{% if string.types %}
{{accessModifier}} static func {{string.name|swiftIdentifier:"pretty"|lowerFirstWord|escapeReservedKeywords}}({% call parametersBlock string.types %}) -> LocalizedStringResource {
  LocalizedStringResource(
    "{{string.key}}",
    defaultValue: "{% call interpolationsBlock string.types literals %}",
    table: "{{table}}",
    bundle: {{param.bundle|default:"#bundle"}}
  )
}
{% else %}
{{accessModifier}} static var {{string.name|swiftIdentifier:"pretty"|lowerFirstWord|escapeReservedKeywords}}: LocalizedStringResource {
  LocalizedStringResource(
    "{{string.key}}",
    defaultValue: "{{translation}}",
    table: "{{table}}",
    bundle: {{param.bundle|default:"#bundle"}}
  )
}
{% endif %}
{% endfor %}
{% for child in item.children %}
{{accessModifier}} enum {{child.name|swiftIdentifier:"pretty"|escapeReservedKeywords}} {
{% filter indent:2," ",true %}{% call recursiveBlock table child %}{% endfilter %}
}
{% endfor %}
{% endmacro %}

extension LocalizedStringResource {
{% if tables.count > 1 or param.forceFileNameEnum %}
{% for table in tables %}
{{accessModifier}} enum {{table.name|swiftIdentifier:"pretty"|escapeReservedKeywords}} {
{% filter indent:2," ",true %}{% call recursiveBlock table.name table.levels %}{% endfilter %}
}
{% endfor %}
{% else %}
{% filter indent:2," ",true %}{% call recursiveBlock tables.first.name tables.first.levels %}{% endfilter %}
{% endif %}
}
{% else %}
// No localized string found.
{% endif %}
